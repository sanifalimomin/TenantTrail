{
  "info": {
    "name": "TenantTrails API",
    "description": "TenantTrails API collection. Auth uses an httpOnly cookie: run Signup or Login first and Postman's cookie jar stores the `token` cookie, which it then sends automatically on the protected requests below. No Authorization header is needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@dal.ca\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/signup"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@dal.ca\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Me (auth)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout"
      }
    },
    {
      "name": "List apartments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/apartments"
      }
    },
    {
      "name": "Get apartment",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/apartments/3"
      }
    },
    {
      "name": "List apartment reviews",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/apartments/3/reviews"
      }
    },
    {
      "name": "Add review (auth)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"body\": \"Great building, fast maintenance.\"\n}"
        },
        "url": "{{baseUrl}}/api/apartments/3/reviews"
      }
    },
    {
      "name": "Add review — no cookie (expect 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"body\": \"Nice\"\n}"
        },
        "url": "{{baseUrl}}/api/apartments/1/reviews"
      }
    },
    {
      "name": "Edit review (auth, owner)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 4,\n  \"body\": \"Updated: still solid, parking is tight.\"\n}"
        },
        "url": "{{baseUrl}}/api/reviews/1"
      }
    },
    {
      "name": "Delete review (auth, owner)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/reviews/1"
      }
    },
    {
      "name": "Profile (auth)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/profile"
      }
    },
    {
      "name": "Upload image (auth, form-data)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "image", "type": "file", "src": [] }]
        },
        "url": "{{baseUrl}}/api/upload"
      }
    }
  ]
}
